{
  "name": "shoallhell",
  "private": true,
  "version": "1.0.0",
  "description": "Shoallhell: a card-driven tactical dungeon crawler in the Dungeon Joe world. Solo or online co-op, email + password accounts.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "socket.io-client": "^4.8.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
